# Server-side only — set these in the Vercel dashboard
# (Settings -> Environment Variables), for all environments.
# Consumed by api/booking-webhook.js. None of these reach the browser.

# Shared secret configured on the Cal.com webhook
# (cal.com -> Settings -> Developer -> Webhooks -> Secret).
# Used to verify the x-cal-signature-256 HMAC on every incoming request.
CAL_WEBHOOK_SECRET=

# API key from resend.com
RESEND_API_KEY=

# Where booking notifications are sent.
# IMPORTANT: while FROM_EMAIL is the default onboarding@resend.dev sender,
# Resend will ONLY deliver to the email address that owns the Resend account.
# Set this to that address. To notify anyone else, verify a domain in Resend
# and change FROM_EMAIL below — no code change needed.
NOTIFY_EMAIL=

# Defaults to onboarding@resend.dev if unset.
# Once meenuagarwal.in is verified in Resend, set this to bookings@meenuagarwal.in.
FROM_EMAIL=onboarding@resend.dev
